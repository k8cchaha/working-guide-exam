# Vercel Postgres — 從 Vercel Dashboard > Storage > 你的 DB > .env.local 複製貼上
DATABASE_URL="postgres://..."
DATABASE_URL_UNPOOLED="postgres://..."

# Admin 帳號密碼，JSON 陣列，可多組
# 格式：[{"username":"admin1","password":"pass1"},{"username":"admin2","password":"pass2"}]
ADMIN_USERS='[{"username":"admin","password":"admin123"}]'

# 隨機長字串，用來簽署 JWT Cookie（可用 openssl rand -base64 32 產生）
JWT_SECRET="your-random-secret-here"

# 部署後填入你的網域（開發時留空即可）
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
