generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Exam {
  id            String       @id @default(cuid())
  adminUsername String       @default("")
  authMode      String       @default("NAME_ONLY")
  passingScore  Int
  status        ExamStatus   @default(ACTIVE)
  publishedAt   DateTime?
  createdAt     DateTime     @default(now())
  members       Member[]
  submissions   Submission[]
}

model Member {
  id         String      @id @default(cuid())
  examId     String
  name       String
  password   String?
  exam       Exam        @relation(fields: [examId], references: [id], onDelete: Cascade)
  submission Submission?

  @@unique([examId, name])
}

model Submission {
  id          String   @id @default(cuid())
  examId      String
  memberId    String   @unique
  answers     Json
  autoScore   Int      @default(0)
  manualScore Int?
  totalScore  Int?
  avatarId    String
  submittedAt DateTime @default(now())
  member      Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  exam        Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
}

model SavedList {
  id            String            @id @default(cuid())
  adminUsername String
  name          String
  authMode      String            @default("NAME_ONLY")
  createdAt     DateTime          @default(now())
  members       SavedListMember[]

  @@unique([adminUsername, name])
}

model SavedListMember {
  id          String    @id @default(cuid())
  savedListId String
  name        String
  password    String?
  savedList   SavedList @relation(fields: [savedListId], references: [id], onDelete: Cascade)

  @@unique([savedListId, name])
}

model Question {
  id            String   @id @default(cuid())
  adminUsername String
  isShared      Boolean  @default(false)
  type          String
  text          String
  points        Int      @default(3)
  isBonus       Boolean  @default(false)
  options       Json?
  gradingHint   String?
  createdAt     DateTime @default(now())
}

enum ExamStatus {
  ACTIVE
  PUBLISHED
}
